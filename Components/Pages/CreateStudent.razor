@page "/students/create"
@using StudentSystemApp.Models
@using StudentSystemApp.Services
@inject StudentRepository StudentRepo
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Create Student</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="4" Class="pa-6">
        <MudText Typo="Typo.h5" GutterBottom="true">Add New Student</MudText>

        <EditForm Model="student" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />

            <MudTextField Label="Student Number" @bind-Value="student.StudentNumber" 
                          For="@(() => student.StudentNumber)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-4" />

            <MudTextField Label="Full Name" @bind-Value="student.FullName" 
                          For="@(() => student.FullName)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-4" />

            <MudTextField Label="Course" @bind-Value="student.Course" 
                          For="@(() => student.Course)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-4" />

            <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-6">
                <MudButton ButtonType="ButtonType.Button" Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Loading="@isLoading">Create Student</MudButton>
            </MudStack>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    private Student student = new() { Id = Guid.NewGuid().ToString() };
    private bool isLoading = false;

    private async Task HandleValidSubmit()
    {
        isLoading = true;
        try
        {
            await StudentRepo.CreateAsync(student);
            Snackbar.Add("Student created successfully!", Severity.Success);
            Navigation.NavigateTo("/students");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/students");
    }
}
