@page "/students/create"
@using StudentSystemApp.Models
@using StudentSystemApp.Services
@inject StudentRepository StudentRepo
@inject CourseRepository CourseRepo
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Create Student</PageTitle>

<div class="container mt-4">
    <h2>Add New Student</h2>

    <EditForm Model="student" OnValidSubmit="HandleValidSubmit" class="card p-4">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Student Number</label>
            <InputText @bind-Value="student.StudentNumber" class="form-control" placeholder="e.g. S003" />
            <ValidationMessage For="@(() => student.StudentNumber)" />
        </div>

        <div class="mb-3">
            <label>Full Name</label>
            <InputText @bind-Value="student.FullName" class="form-control" placeholder="John Doe" />
            <ValidationMessage For="@(() => student.FullName)" />
        </div>

        <div class="mb-3">
            <label>Course</label>
            <InputSelect @bind-Value="student.CourseId" class="form-control">
                <option value="0">-- Select Course --</option>
                @foreach (var course in courses)
                {
                    <option value="@course.CourseId">@course.CourseDescription</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => student.CourseId)" />
        </div>

        <button type="submit" class="btn btn-success me-2 create-btn" disabled="@isLoading">Create Student</button>
        <button type="button" class="btn btn-secondary create-btn" @onclick="Cancel">Cancel</button>
    </EditForm>
</div>

@code {
    private Student student = new() { Id = Guid.NewGuid().ToString() };
    private List<Course> courses = new();
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        courses = await CourseRepo.GetAllAsync();
    }

    private async Task HandleValidSubmit()
    {
        isLoading = true;
        try
        {
            await StudentRepo.CreateAsync(student);
            Navigation.NavigateTo("/students");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/students");
    }

    public void Dispose() { }
}
