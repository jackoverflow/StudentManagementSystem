@page "/students/create"
@using StudentSystemApp.Models
@using StudentSystemApp.Services
@inject StudentRepository StudentRepo
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Create Student</PageTitle>

<div class="container mt-4">
    <h2>Add New Student</h2>

    <EditForm Model="student" OnValidSubmit="HandleValidSubmit" class="card p-4">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Student Number</label>
            <InputText @bind-Value="student.StudentNumber" class="form-control" placeholder="e.g. S003" />
            <ValidationMessage For="@(() => student.StudentNumber)" />
        </div>

        <div class="mb-3">
            <label>Full Name</label>
            <InputText @bind-Value="student.FullName" class="form-control" placeholder="John Doe" />
            <ValidationMessage For="@(() => student.FullName)" />
        </div>

        <div class="mb-3">
            <label>Course</label>
            <InputText @bind-Value="student.Course" class="form-control" placeholder="Computer Science" />
            <ValidationMessage For="@(() => student.Course)" />
        </div>

        <button type="submit" class="btn btn-success me-2" disabled="@isLoading">Create Student</button>
        <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
    </EditForm>
</div>

@code {
    private Student student = new();
    private bool isLoading = false;

    private async Task HandleValidSubmit()
    {
        isLoading = true;
        try
        {
            await StudentRepo.CreateAsync(student);
            Navigation.NavigateTo("/students");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/students");
    }

    public void Dispose() { }
}
