@page "/students/edit/{Id}"
@using StudentSystemApp.Models
@using StudentSystemApp.Services
@inject StudentRepository StudentRepo
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Edit Student</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="4" Class="pa-6">
        <MudText Typo="Typo.h5" GutterBottom="true">Edit Student</MudText>

        @if (studentNotFound)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-2">Student not found.</MudAlert>
            <MudButton Variant="Variant.Text" OnClick="Cancel" Class="mt-4">Back to List</MudButton>
        }
        else
        {
            <EditForm Model="student" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                <MudTextField Label="ID (Read-only)" @bind-Value="student.Id" ReadOnly="true" 
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-4" Disabled="true" />

                <MudTextField Label="Student Number" @bind-Value="student.StudentNumber" 
                              For="@(() => student.StudentNumber)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-4" />

                <MudTextField Label="Full Name" @bind-Value="student.FullName" 
                              For="@(() => student.FullName)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-4" />

                <MudTextField Label="Course" @bind-Value="student.Course" 
                              For="@(() => student.Course)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-4" />

                <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-6">
                    <MudButton ButtonType="ButtonType.Button" Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Loading="@isLoading">Update Student</MudButton>
                </MudStack>
            </EditForm>
        }
    </MudPaper>
</MudContainer>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    private Student student = new();
    private bool isLoading = false;
    private bool studentNotFound = false;
    
    // Using OnParametersSetAsync ensures data reloads if the ID in the URL changes
    protected override async Task OnParametersSetAsync()
    {
        var loadedStudent = await StudentRepo.GetByIdAsync(Id);
        if (loadedStudent == null)
        {
            studentNotFound = true;
        }
        else
        {
            studentNotFound = false;
            student = loadedStudent;
        }
    }

    private async Task HandleValidSubmit()
    {
        isLoading = true;
        try
        {
            await StudentRepo.UpdateAsync(student);
            Snackbar.Add("Student updated successfully!", Severity.Success);
            Navigation.NavigateTo("/students");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/students");
    }
}
