@page "/"
@using StudentSystemApp.Models

<PageTitle>Students</PageTitle>

<div class="container mt-4">
    <h1 class="mb-4">Student Information System</h1>

    <h3 class="mb-3">Student List</h3>

    @if (students == null)
    {
        <div class="alert alert-info">Loading students...</div>
    }
    else if (!students.Any())
    {
        <div class="alert alert-warning">No students found in the system.</div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Student Number</th>
                    <th>Full Name</th>
                    <th>Course</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in students)
                {
                    <tr>
                        <td><small class="text-muted">@student.Id</small></td>
                        <td>@student.StudentNumber</td>
                        <td>@student.FullName</td>
                        <td>@student.Course</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<Student> students = new();

    protected override void OnInitialized()
    {
        // Initializing with some dummy data for demonstration
        students.Add(new Student { Id = "1", StudentNumber = "2024-001", FullName = "Alice Johnson", Course = "Computer Science" });
        students.Add(new Student { Id = "2", StudentNumber = "2024-002", FullName = "Bob Smith", Course = "Information Technology" });
    }
}