@page "/students"
@using StudentSystemApp.Models
@using StudentSystemApp.Services
@using Microsoft.JSInterop
@inject StudentRepository StudentRepo

<PageTitle>Students</PageTitle>

<div class="container mt-4">
    <h1 class="mb-4">Student Information System</h1>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Student List</h3>
        <NavLink href="/students/create" class="btn btn-primary">+ New Student</NavLink>
    </div>

    @if (isLoading)
    {
        <div class="alert alert-info">Loading students...</div>
    }
    else if (students?.Any() != true)
    {
        <div class="alert alert-warning">No students found in the system.</div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Student Number</th>
                    <th>Full Name</th>
                    <th>Course</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in students)
                {
                    <tr>
                        <td><small class="text-muted">@student.Id</small></td>
                        <td>@student.StudentNumber</td>
                        <td>@student.FullName</td>
                        <td>@student.Course</td>
                        <td>
                            <NavLink href="/students/edit/@student.Id" class="btn btn-warning btn-sm me-1">
                                <i class="bi bi-pencil"></i> Edit
                            </NavLink>
                            <button class="btn btn-danger btn-sm" @onclick="() => DeleteStudent(student.Id)" disabled="@isDeleting">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<Student>? students;
    private bool isLoading = true;
    private bool isDeleting = false;

    [Inject] IJSRuntime JSRuntime { get; set; } = default!;

    private async Task LoadStudents()
    {
        isLoading = true;
        StateHasChanged();
        var result = await StudentRepo.GetAllAsync();
        students = result.ToList();
        isLoading = false;
        StateHasChanged();
    }

    private async Task DeleteStudent(string id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete student with ID {id}? This cannot be undone.");
        if (!confirmed) return;

        isDeleting = true;
        StateHasChanged();

        try
        {
            await StudentRepo.DeleteAsync(id);
            await LoadStudents();
        }
        catch (Exception ex)
        {
            // Simple logging, could show toast/error
            Console.WriteLine($"Delete error: {ex.Message}");
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadStudents();
    }
}
