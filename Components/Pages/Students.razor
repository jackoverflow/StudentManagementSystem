@page "/students"
@using StudentSystemApp.Models
@using StudentSystemApp.Services
@using Microsoft.JSInterop
@using MudBlazor
@inject StudentRepository StudentRepo
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Students</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h4">Student Information System</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" href="/students/create">
            New Student
        </MudButton>
    </MudStack>

    <MudTable Items="@students" Loading="@isLoading" Hover="true" Striped="true" Elevation="2">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Student List</MudText>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>ID</MudTh>
            <MudTh>Student Number</MudTh>
            <MudTh>Full Name</MudTh>
            <MudTh>Course</MudTh>
            <MudTh Style="text-align:right">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ID"><MudText Typo="Typo.caption" Color="Color.Secondary">@context.Id</MudText></MudTd>
            <MudTd DataLabel="Student Number">@context.StudentNumber</MudTd>
            <MudTd DataLabel="Full Name">@context.FullName</MudTd>
            <MudTd DataLabel="Course">@context.Course</MudTd>
            <MudTd DataLabel="Actions" Style="text-align:right">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small" href="@($"/students/edit/{context.Id}")" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteStudent(context.Id)" Disabled="@isDeleting" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No students found in the system.</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudText>Loading students...</MudText>
        </LoadingContent>
    </MudTable>
</MudContainer>

@code {
    private List<Student>? students;
    private bool isLoading = true;
    private bool isDeleting = false;

    private async Task LoadStudents()
    {
        isLoading = true;
        try
        {
            var result = await StudentRepo.GetAllAsync();
            students = result.ToList();
        }
        finally { }
        isLoading = false;
        StateHasChanged();
    }

    private async Task DeleteStudent(string id)
    {
        bool? confirmed = await DialogService.ShowMessageBox(
            "Confirm Delete", 
            "Are you sure you want to delete this student? This action cannot be undone.", 
            yesText: "Delete", cancelText: "Cancel");

        if (confirmed != true) return;

        isDeleting = true;
        
        try
        {
            await StudentRepo.DeleteAsync(id);
            Snackbar.Add("Student deleted successfully", Severity.Success);
            await LoadStudents();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting student: {ex.Message}", Severity.Error);
            StateHasChanged();
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadStudents();
    }
}
